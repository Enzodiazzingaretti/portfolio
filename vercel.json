{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "portfolio-kexxy.vercel.app"
        }
      ],
      "destination": "https://enzo-diaz-zingaretti.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portfolio-kexxy.vercel.app"
        }
      ],
      "destination": "https://enzo-diaz-zingaretti.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/web/ctrl-z",
      "destination": "/tech/press-kits",
      "permanent": true
    },
    {
      "source": "/tech/ctrl-z",
      "destination": "/tech/press-kits",
      "permanent": true
    },
    {
      "source": "/web",
      "destination": "/tech",
      "permanent": true
    },
    {
      "source": "/web/:caso",
      "destination": "/tech/:caso",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|images/|cv/|content.json|assets/|favicon|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
